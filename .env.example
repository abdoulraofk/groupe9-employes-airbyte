# Copier en .env puis ajuster si besoin. Les valeurs ci-dessous sont celles
# utilisees par defaut dans docker-compose.yml (donnees de demonstration,
# sans caractere sensible reel).

MYSQL_ROOT_PASSWORD=root_pwd
MYSQL_DATABASE=rh_source
MYSQL_READER_USER=airbyte_reader
MYSQL_READER_PASSWORD=airbyte_reader_pwd

POSTGRES_DB=rh_target
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pwd
API_READER_PASSWORD=api_reader_pwd
