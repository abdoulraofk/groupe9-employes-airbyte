          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"reponse paginee\", () => pm.expect(body).to.have.all.keys('data','page','per_page','total','total_pages'));",
                  "console.log('total pour prefixe EMP00 =', body.total, '(attendu dans le jeu de demo : 30)');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /employes?service=FIN",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/employes?service=FIN",
              "host": ["{{base_url}}"],
              "path": ["employes"],
              "query": [{ "key": "service", "value": "FIN" }]
