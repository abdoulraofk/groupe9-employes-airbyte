              "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "GET /fonctions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/fonctions", "host": ["{{base_url}}"], "path": ["fonctions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Avant synchronisation (apres modification MySQL)",
      "item": [
        {
          "name": "0. (A faire manuellement) UPDATE cote MySQL",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Pas un appel HTTP : executer avant de continuer, dans un terminal, depuis le dossier du projet :\n\n```bash\ndocker exec -it rh_mysql_source mysql -uroot -p\"root_pwd\" -e \\\n  \"UPDATE rh_source.employes SET nom='KABORE-TRAORE' WHERE matricule='EMP0001';\"\n```\n\nCette requete ne fait que revalider que l'API repond, afin de garder cette etape dans la collection ; l'action reelle (UPDATE MySQL) se fait en dehors de Postman."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "GET /employes/{{matricule}} (doit encore montrer l'ancienne valeur)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/employes/{{matricule}}",
              "host": ["{{base_url}}"],
              "path": ["employes", "{{matricule}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "console.log('nom renvoye par l API =', body.nom);",
                  "console.log('Attendu ICI : encore KABORE (la synchronisation n a pas encore tourne). Si deja KABORE-TRAORE, une sync a eu lieu entre temps.');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /meta/freshness (age_seconds eleve)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/meta/freshness", "host": ["{{base_url}}"], "path": ["meta", "freshness"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "console.log('age_seconds employes =', body.tables.employes.age_seconds);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Declenchement de la synchronisation Airbyte",
      "item": [
        {
          "name": "POST token (client_id/client_secret -> access_token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{airbyte_url}}/api/public/v1/applications/token",
              "host": ["{{airbyte_url}}"],
              "path": ["api", "public", "v1", "applications", "token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{airbyte_client_id}}\",\n  \"client_secret\": \"{{airbyte_client_secret}}\"\n}"
            },
            "description": "client_id/client_secret donnes par `abctl local credentials`. Le token est valable 15 min (expires_in=900) ; relancer cette requete s'il expire pendant la demo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('airbyte_token', body.access_token);",
                  "pm.test(\"token recupere\", () => pm.expect(body.access_token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST jobs (declenche la sync)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{airbyte_token}}" }
            ],
            "url": {
              "raw": "{{airbyte_url}}/api/public/v1/jobs",
              "host": ["{{airbyte_url}}"],
              "path": ["api", "public", "v1", "jobs"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"connectionId\": \"{{airbyte_connection_id}}\",\n  \"jobType\": \"sync\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('airbyte_job_id', body.jobId);",
                  "console.log('job demarre, id =', body.jobId, '| status =', body.status);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET jobs/{{airbyte_job_id}} (statut - relancer jusqu'a succeeded)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{airbyte_token}}" }],
            "url": {
              "raw": "{{airbyte_url}}/api/public/v1/jobs/{{airbyte_job_id}}",
              "host": ["{{airbyte_url}}"],
              "path": ["api", "public", "v1", "jobs", "{{airbyte_job_id}}"]
            },
            "description": "A rejouer (bouton Send) toutes les 10-15 s pendant la demo jusqu'a ce que `status` passe a `succeeded` (ou `incomplete` : voir note dans airbyte/README.md -- les donnees arrivent generalement malgre ce statut sur un cluster kind local sous contrainte de ressources, verifier dans ce cas avec le dossier 5)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "console.log('status =', body.status, '| rowsSynced =', body.rowsSynced, '| duration =', body.duration);"
                ]
              }
            }
          ]
        }
      ]
    },
